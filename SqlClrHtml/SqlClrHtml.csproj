<Project Sdk="Microsoft.NET.Sdk">

  <!--
    QueryToHtml and ConCatHtml: a SAFE assembly, so it runs wherever SQL Server runs CLR code,
    Linux included. SQL Server runs CLR assemblies on .NET Framework 4.x only, up to SQL Server 2025.
  -->
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>SimpleTalk.SQLCLR.Html</AssemblyName>
    <RootNamespace>SimpleTalk.SqlClr.Html</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Version>2.0.0</Version>
    <Company>Darko Martinovic</Company>
    <Product>SQLCLR</Product>
    <Description>Query results as HTML tables for e-mails</Description>
    <Copyright>Darko Martinovic</Copyright>
    <!-- The setup script carries the assembly: no debug directory with a local path in it -->
    <DebugType>none</DebugType>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <ItemGroup>
    <!-- Lets dotnet build compile for .NET Framework on any OS -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Xml.Linq" />
  </ItemGroup>

</Project>
