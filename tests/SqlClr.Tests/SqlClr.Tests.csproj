<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.1.1" />
    <!-- SqlClient brings 9.0.18, which has known vulnerabilities -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.14" />
    <!-- Parses what the stand-in SMTP server receives -->
    <PackageReference Include="MimeKit" Version="4.18.2" />
    <PackageReference Include="Testcontainers.MsSql" Version="4.16.0" />
    <PackageReference Include="xunit.v3" Version="4.0.2" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!-- One SQL Server at a time: each needs 2 GB -->
    <Content Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- The tests install the committed setup scripts, and check they are as new as the sources -->
    <Compile Include="..\..\tools\SetupScript\SourceHash.cs" Link="SourceHash.cs" />
    <AssemblyMetadata Include="RepositoryRoot" Value="$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../..'))" />
  </ItemGroup>

</Project>
